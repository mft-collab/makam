rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // İlgili görevin sahibi (oluşturan/sorumlu), görevin departmanındaki
    // kullanıcı veya Admin — firestore.rules'taki tasks okuma deseniyle aynı.
    function canAccessTask(taskId) {
      let task = firestore.get(/databases/(default)/documents/tasks/$(taskId)).data;
      let requester = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return isAdmin() ||
        task.creatorId == request.auth.uid ||
        task.assigneeId == request.auth.uid ||
        (('email' in request.auth.token) && task.assigneeId == request.auth.token.email) ||
        (!('departmentId' in task)) || task.departmentId == null || task.departmentId == '' ||
        task.departmentId == requester.departmentId;
    }

    match /evidence/{taskId}/{fileName} {
      // Yalnızca ilgili görevi görebilecek kullanıcılar okuyabilir/yazabilir —
      // önceden herhangi bir oturum açmış kullanıcı herhangi bir taskId altına
      // dosya yükleyebiliyordu (görev sahipliği/departman kontrolü yoktu).
      allow read: if isAuthenticated() && canAccessTask(taskId);

      // Sadece resim ve PDF dosyalarına izin ver, max 5MB
      allow write: if isAuthenticated() && canAccessTask(taskId) &&
                   (request.resource.contentType.matches('image/.*') ||
                    request.resource.contentType == 'application/pdf') &&
                   request.resource.size < 5 * 1024 * 1024;

      // Silme yetkisi sadece Admin'de
      allow delete: if isAdmin();
    }
  }
}
